{
  "$defs": {
    "BeatAnimation": {
      "additionalProperties": false,
      "description": "Move one slider from `start` to `end` while its beat is spoken (equal values hold it there).",
      "properties": {
        "binding": {
          "title": "Binding",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "seconds": {
          "default": 3.0,
          "maximum": 12,
          "minimum": 0.5,
          "title": "Seconds",
          "type": "number"
        }
      },
      "required": [
        "binding",
        "start",
        "end"
      ],
      "title": "BeatAnimation",
      "type": "object"
    },
    "TeachingBeat": {
      "additionalProperties": false,
      "properties": {
        "beat_id": {
          "title": "Beat Id",
          "type": "string"
        },
        "say_text": {
          "title": "Say Text",
          "type": "string"
        },
        "focus_ids": {
          "items": {
            "type": "string"
          },
          "title": "Focus Ids",
          "type": "array"
        },
        "cue": {
          "default": "immediate",
          "title": "Cue",
          "type": "string"
        },
        "allow_interrupt": {
          "default": true,
          "title": "Allow Interrupt",
          "type": "boolean"
        },
        "animations": {
          "items": {
            "$ref": "#/$defs/BeatAnimation"
          },
          "maxItems": 3,
          "title": "Animations",
          "type": "array"
        }
      },
      "required": [
        "beat_id",
        "say_text",
        "focus_ids"
      ],
      "title": "TeachingBeat",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "recipe_id": {
      "title": "Recipe Id",
      "type": "string"
    },
    "beats": {
      "items": {
        "$ref": "#/$defs/TeachingBeat"
      },
      "title": "Beats",
      "type": "array"
    },
    "comprehension_prompt": {
      "default": "How well do you understand this concept, from 1 to 10?",
      "title": "Comprehension Prompt",
      "type": "string"
    },
    "graph_context": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Graph Context"
    },
    "planned_by": {
      "default": "authored",
      "title": "Planned By",
      "type": "string"
    },
    "concept_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Concept Id"
    },
    "generated": {
      "default": false,
      "title": "Generated",
      "type": "boolean"
    },
    "tutor": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tutor"
    }
  },
  "required": [
    "recipe_id",
    "beats"
  ],
  "title": "LessonPlan",
  "type": "object"
}
