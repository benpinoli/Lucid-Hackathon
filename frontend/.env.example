# Server-side Vite configuration only. Never put credentials in VITE_* variables.
LUCID_BACKEND_URL=http://127.0.0.1:8000
LUCID_FRONTEND_HOST=localhost
# For a headset, use a trusted certificate including the LAN hostname/IP.
# LUCID_TLS_CERT=C:/path/to/lucid.pem
# LUCID_TLS_KEY=C:/path/to/lucid-key.pem
